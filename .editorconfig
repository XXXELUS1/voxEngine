# https://editorconfig.org - shared editor settings for voxEngine.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot GDScript and shaders use tabs (the Godot editor default); C++ follows Godot style too.
[*.{gd,gdshader,cpp,h,hpp}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[SConstruct]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,sh}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
