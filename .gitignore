# Godot
godot/.godot/
godot/addons/voxbody/bin/*
!godot/addons/voxbody/bin/.gitkeep
godot/export/
*.import.tmp

# C++ build (src/voxbody; godot-cpp is a submodule and keeps its own outputs out of git)
src/voxbody/.sconsign.dblite
src/voxbody/src/*.o
src/voxbody/src/*.os
src/voxbody/src/*.obj
src/voxbody/src/*.pdb
src/voxbody/*.log
.scons-cache/

# Python
__pycache__/
*.pyc
.pytest_cache/
tools/voxgen/build/
*.egg-info/

# Generated assets (rebuilt from specs by voxgen: make assets)
godot/assets/models/*.vxm
godot/assets/models/*.vox
build/

# User screenshots / local stuff
/screenshot*.png
/screenshots/
godot/screenshot*.png
godot/screenshots/
.venv/
*.swp
